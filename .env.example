# Optional. Public endpoints are used when these are absent.
# Keep provider credentials on the server; never use a VITE_ prefix.
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
PORT=4174
# Use 0.0.0.0 inside a hosting container; loopback is the local default.
HOST=127.0.0.1
